{
  "version": 2,
  "devCommand": "python -m uvicorn app:app --host 0.0.0.0 --port 8000",
  "framework": "fastapi",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "MODEL_TYPE": "gap_cold",
    "LOG_LEVEL": "info"
  },
  "github": {
    "enabled": true,
    "autoAlias": true
  }
}