{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "python -m uvicorn app:app --host 0.0.0.0 --port 8000",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "runtime": "python3.11"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "MODEL_TYPE": "logistic",
    "LOG_LEVEL": "info"
  },
  "github": {
    "enabled": true,
    "autoAlias": true
  }
}